# npm 10.9.4 bricht beim Aufloesen des Peer-Graphen der Test-Abhaengigkeiten
# (vitest/msw/jsdom) mit einem Arborist-Bug ab: "Cannot read properties of
# null (reading 'edgesOut')". Der Fehler liegt in npm, nicht in den Paketen --
# msw ist ein optionaler Peer von @vitest/mocker und wird gar nicht
# installiert. Diese Einstellung umgeht den Bug, ohne eine Version zu aendern.
# Mit einer npm-Version, die den Bug behoben hat, kann die Zeile entfallen.
legacy-peer-deps=true
